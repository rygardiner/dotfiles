{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/pack-schema.json",
  "name": "gruvbox-bar",
  "displayName": "Gruvbox Bar",
  "description": "Gruvbox-dark transparent top bar for GlazeWM.",
  "tags": ["bar", "gruvbox", "glazewm"],
  "excludeFiles": "",
  "galleryAssets": [],
  "previewImages": [],
  "repositoryUrl": "",
  "version": "1.0.0",
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": []
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "40px",
          "monitorSelection": { "type": "all" },
          "dockToEdge": {
            "enabled": true,
            "edge": "top",
            "windowMargin": "0px"
          }
        }
      ]
    }
  ]
}
